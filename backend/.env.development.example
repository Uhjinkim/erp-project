# Copy to backend/.env.development. Never commit the real values.
DJANGO_SECRET_KEY=replace-with-a-local-development-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Set true to run the backend without PostgreSQL or Redis and report offline simulation.
DEVELOPMENT_OFFLINE_MODE=false
# Optional: SQLite path used only when DEVELOPMENT_OFFLINE_MODE=true.
# DEVELOPMENT_SQLITE_PATH=/absolute/path/to/development.sqlite3
VACATION_INTEGRATION_MODE=database
# Allow the initial Redis handshake through SSH forwarding.
HEALTH_CHECK_TIMEOUT_SECONDS=10.0

# Local ends of the SSH tunnels.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=erp
DB_USER=erp
DB_PASSWORD=replace-with-a-strong-development-password
# Per-process pool for Django runserver; production keeps its WSGI persistent connections.
DB_POOL_ENABLED=true
DB_POOL_MIN_SIZE=0
DB_POOL_MAX_SIZE=4
DB_POOL_TIMEOUT=15
DB_CONNECT_TIMEOUT=10
REDIS_URL=redis://127.0.0.1:6379/0

# Local testing only. false lets employees with three months of service or less be evaluated.
# Production always applies the rule.
EVALUATION_MINIMUM_TENURE_ENABLED=true

# Best-effort cache for reference lists only. Never caches permissions/balances.
REFERENCE_CACHE_ENABLED=false
REFERENCE_CACHE_TTL=180
REFERENCE_CACHE_TIMEOUT=0.2
# Defaults to REDIS_URL; use rediss:// for ElastiCache with TLS.
# REFERENCE_CACHE_URL=rediss://app-user:password@cache-endpoint:6379/0
# Isolate every deployment sharing a Redis/Valkey instance.
REFERENCE_CACHE_KEY_PREFIX=erp:development:reference:v1
