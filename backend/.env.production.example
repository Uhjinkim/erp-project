# Copy to backend/.env.production through the deployment secret/configuration system.
DJANGO_SECRET_KEY=replace-with-a-production-secret
DJANGO_ALLOWED_HOSTS=erp.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://erp.example.com
# Raise after HTTPS has been verified. Does not cover subdomains or enable preload.
DJANGO_SECURE_HSTS_SECONDS=3600

DB_HOST=replace-with-the-production-database-host
DB_PORT=5432
DB_NAME=erp
DB_USER=erp
DB_PASSWORD=replace-with-a-production-database-password
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT=5
# Use the actual RDS endpoint (certificate hostname), not a localhost SSH tunnel.
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/etc/erp/rds-global-bundle.pem

REDIS_URL=redis://replace-with-the-production-redis-host:6379/0
HEALTH_CHECK_TIMEOUT_SECONDS=1.0

# Best-effort cache for reference lists only. Never caches permissions/balances.
REFERENCE_CACHE_ENABLED=true
REFERENCE_CACHE_TTL=180
REFERENCE_CACHE_TIMEOUT=0.2
# Defaults to REDIS_URL; use rediss:// for ElastiCache with TLS.
# REFERENCE_CACHE_URL=rediss://app-user:password@cache-endpoint:6379/0
# Isolate every deployment sharing a Redis/Valkey instance.
REFERENCE_CACHE_KEY_PREFIX=erp:production:reference:v1
