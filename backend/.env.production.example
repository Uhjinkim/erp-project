# Copy to backend/.env.production through the deployment secret/configuration system.
DJANGO_SECRET_KEY=replace-with-a-production-secret
DJANGO_ALLOWED_HOSTS=erp.example.com

DB_HOST=replace-with-the-production-database-host
DB_PORT=5432
DB_NAME=erp
DB_USER=erp
DB_PASSWORD=replace-with-a-production-database-password
DB_CONN_MAX_AGE=60

REDIS_URL=redis://replace-with-the-production-redis-host:6379/0
HEALTH_CHECK_TIMEOUT_SECONDS=1.0
