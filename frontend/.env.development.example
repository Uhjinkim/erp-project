# Copy to frontend/.env.development. Only VITE_ variables are exposed to browser code.
VITE_APP_ENV=development
VITE_AUTH_MODE=session
VITE_API_BASE_URL=
VITE_API_TIMEOUT_MS=5000
VITE_HEALTH_POLL_INTERVAL_MS=10000
VITE_ENABLE_CONNECTION_TEST_CONTROLS=true
VITE_DEV_OFFLINE_MODE=false
# Local testing only; keep equal to the backend EVALUATION_MINIMUM_TENURE_ENABLED.
VITE_EVALUATION_MINIMUM_TENURE_ENABLED=true
