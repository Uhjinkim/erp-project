pid /tmp/nginx.pid;
error_log /dev/stderr warn;
worker_processes auto;
events { worker_connections 1024; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log off;
    sendfile on;
    server_tokens off;
    client_body_temp_path /tmp/client_temp;
    proxy_temp_path /tmp/proxy_temp;
    fastcgi_temp_path /tmp/fastcgi_temp;
    uwsgi_temp_path /tmp/uwsgi_temp;
    scgi_temp_path /tmp/scgi_temp;
    # Docker embedded DNS: re-resolve backend after container replacement.
    resolver 127.0.0.11 valid=10s ipv6=off;
    server {
        listen 8080 default_server;
        server_name _;
        location = /healthz { access_log off; return 204; }
        location / { return 444; }
    }
    server {
        listen 8080;
        server_name ${ERP_DOMAIN};
        root /usr/share/nginx/html;
        index index.html;
        client_max_body_size 2m;
        location = /healthz { access_log off; return 204; }
        location /static/ { alias /usr/share/nginx/static/; }
        location /assets/ {
            try_files $uri =404;
            expires 1y;
            add_header Cache-Control "public, immutable";
        }
        location = /index.html { add_header Cache-Control "no-store"; }
        location ~ ^/(api|admin)(/|$) {
            set $backend http://backend:8000;
            proxy_pass $backend$request_uri;
            proxy_set_header Host $host;
            # Host loopback publication is reserved for cloudflared.
            # Cloudflare must redirect public HTTP to HTTPS.
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_read_timeout 65s;
            add_header Cache-Control "no-store";
        }
        location / { try_files $uri $uri/ /index.html; }
    }
}
