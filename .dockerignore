**/.env.*
**/.venv
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.ruff_cache
**/node_modules
**/dist
**/staticfiles
**/media
**/*.sqlite3
**/*.log
backend/tests
frontend/tests
frontend/mockups
**/*.pem
**/*.key
**/id_rsa*
**/id_ed25519*
**/.ssh
**/*.dump
**/*.sql
**/*.psql
