# Copy this file to .env. Never commit the real values.
# Django connects to the local end of an SSH tunnel.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=erp
DB_USER=erp
DB_PASSWORD=replace-with-a-strong-development-password

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

DJANGO_SECRET_KEY=replace-with-a-local-development-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
