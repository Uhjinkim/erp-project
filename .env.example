# Copy this file to .env. Never commit the real values.
# These credentials must match the .env used by compose.dev.yml on the remote host.
POSTGRES_DB=erp
POSTGRES_USER=erp
POSTGRES_PASSWORD=replace-with-a-strong-development-password
POSTGRES_PORT=5432

# Django connects to the local end of the SSH tunnel.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=erp
DB_USER=erp
DB_PASSWORD=replace-with-a-strong-development-password

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Reference values for the SSH command in README.md.
DEV_INFRA_SSH_HOST=dev-infra.example.com
DEV_INFRA_SSH_USER=replace-with-your-ssh-user

DJANGO_SECRET_KEY=replace-with-a-local-development-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
