# Copy this file to .env. Never commit the real values.
# These values are used only by the SSH tunnel scripts.
SSH_HOST=replace-with-the-ssh-host
SSH_USER=replace-with-the-ssh-user
SSH_PORT=22
# Leave empty to use the default SSH key or enter the path to a private key.
SSH_IDENTITY_FILE=
SSH_TUNNEL_BIND_HOST=127.0.0.1

DB_TUNNEL_LOCAL_PORT=5432
DB_TUNNEL_REMOTE_HOST=127.0.0.1
DB_TUNNEL_REMOTE_PORT=5432

REDIS_TUNNEL_LOCAL_PORT=6379
REDIS_TUNNEL_REMOTE_HOST=127.0.0.1
REDIS_TUNNEL_REMOTE_PORT=6379
