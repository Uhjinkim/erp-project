# Cloudflare named Tunnel -> loopback nginx. Include in nginx's http context.
# Configure the public hostname at Cloudflare with service http://127.0.0.1:8080.
server {
    listen 127.0.0.1:8080 default_server;
    server_name _;
    return 444;
}
server {
    listen 127.0.0.1:8080;
    server_name erp.example.com;
    root /srv/erp/current/frontend/dist;
    index index.html;
    client_max_body_size 2m;

    # URLs may contain employee identifiers or search strings. Avoid access logs.
    access_log off;
    location /static/ {
        alias /srv/erp/current/backend/staticfiles/;
    }
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
    location = /index.html {
        add_header Cache-Control "no-store";
    }
    location ~ ^/(api|admin)(/|$) {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        # cloudflared is the only caller of this loopback listener.
        # Public route must redirect HTTP to HTTPS at Cloudflare's edge.
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 65s;
        add_header Cache-Control "no-store";
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
}
